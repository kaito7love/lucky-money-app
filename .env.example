NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# Not read by the app any more — the browser no longer talks to Supabase
# directly (the host live-view polls the API instead of subscribing). Kept
# only because Supabase hands it to you alongside the others.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any random string of 16+ characters. Set it on the Vercel project too:
# Vercel sends it as `Authorization: Bearer <value>` when it runs the daily
# keep-alive cron, and the endpoint refuses the request without it.
CRON_SECRET=your-random-secret
